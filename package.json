{
  "name": "playwright-docker-kubernetes-testing-lab",
  "version": "1.0.0",
  "description": "Playwright UI and API testing framework with Docker and Kubernetes",
  "license": "MIT",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "npx playwright test --project=api",
    "smoke": "npx playwright test smoketest",
    "report": "npx playwright show-report",
    "lint": "eslint framework tests",
    "format": "prettier --write \"**/*.{ts,mjs,json}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "husky": "^9.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.0.0"
  }
}
